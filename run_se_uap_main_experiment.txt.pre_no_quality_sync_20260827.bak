  --timit_pretrained_detector ./output/pretrain_transformer_detector_utterance/transformer_utterance_detector_trained_on_timit.pth \
  --uap_dim 3200 \
  --train_objective utterance \
  --train_wshift 3200 \
  --eval_wshift 3200 \
  --eval_pool_mode deterministic \
  --train_max_frames 0 \
  --constraint_scope base \
  --kappa 0.0 \
  --num_z 2 \
  --val_fraction 0.1 \
  --val_frd_weight 0.25 \
  --best_min_frd 0.9 \
  --best_min_snr 10 \
  --epochs 10 \
  --batch_size 512 \
  --tau 3 \
