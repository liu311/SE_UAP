from generator import Generator1D


BENIGN_LABEL = 1


def seed_all(seed: int):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def init_worker(worker_id: int, seed: int):
    np.random.seed(seed + worker_id)
    random.seed(seed + worker_id)


def project_l2(delta: torch.Tensor, tau: float, eps: float = 1e-12):
    flat = delta.view(delta.size(0), -1)
    norm = flat.norm(p=2, dim=1, keepdim=True).clamp_min(eps)
    scale = torch.clamp(tau / norm, max=1.0)
    return (flat * scale).view_as(delta)


def recognition_attack_loss(logits: torch.Tensor, labels: torch.Tensor, kappa: float = 0.0):
    """Non-targeted logit-margin loss from Eq. (8) in the manuscript."""
    true_logits = logits[torch.arange(logits.size(0), device=logits.device), labels]
    mask = torch.nn.functional.one_hot(labels, num_classes=logits.size(1)).bool()
    max_other = logits.masked_fill(mask, -1e9).max(dim=1).values
    return torch.clamp(true_logits - max_other + kappa, min=0.0).mean()


def detection_evasion_loss(detector_logits: torch.Tensor, beta: float, eps: float):
    """Detector-aware evasion loss from Eq. (6): p_b(x_adv)^(-beta) - 1."""
    benign_prob = torch.softmax(detector_logits, dim=1)[:, BENIGN_LABEL].clamp_min(eps)
    return (torch.exp(beta * (-torch.log(benign_prob))) - 1.0).mean()


def relative_perturbation_energy(delta: torch.Tensor, clean: torch.Tensor, eps: float):
    """Inverse-SNR energy ratio ||delta||_2^2 / ||x||_2^2."""
    delta_flat = delta.view(delta.size(0), -1)
    clean_flat = clean.view(clean.size(0), -1)
    delta_energy = delta_flat.pow(2).sum(dim=1)
    clean_energy = clean_flat.pow(2).sum(dim=1).clamp_min(eps)
    return (delta_energy / clean_energy).mean()


def energy_loss_raw_delta(raw_delta: torch.Tensor, reference_power: float, args):
    raw_power = raw_delta.pow(2).mean()
    relative_energy = raw_power / (float(reference_power) + args.energy_eps)
    if args.energy_loss_type == "raw_relative":
        return relative_energy
    if args.energy_loss_type == "target_snr":
        target_ratio = 10.0 ** (-args.target_snr / 10.0)
        return torch.relu(relative_energy - target_ratio).pow(2)
    raise ValueError(f"Unsupported energy_loss_type: {args.energy_loss_type}")


def estimate_reference_speech_power(file_list: List[str], data_folder: str, fs: int = 16000):
    powers = []
    for fname in tqdm(file_list, desc="Estimating reference speech power", unit="file"):
        audio, _, _ = load_audio(os.path.join(data_folder, fname), expected_fs=fs, normalize=True)
        powers.append(float(np.mean(np.square(audio, dtype=np.float64))))
    if not powers:
        raise ValueError("Cannot estimate reference speech power from an empty training split")
    return float(np.median(np.asarray(powers, dtype=np.float64)))


def load_or_estimate_reference_speech_power(args, train_files: List[str], data_folder: str):
    os.makedirs(args.output_dir, exist_ok=True)
    cache_path = os.path.join(args.output_dir, f"reference_power_{args.dataset}.npy")
    if os.path.isfile(cache_path):
        reference_power = float(np.load(cache_path))
    else:
        reference_power = estimate_reference_speech_power(train_files, data_folder)
        np.save(cache_path, np.asarray(reference_power, dtype=np.float64))
    print(f"Reference speech power: {reference_power:.10g}")
    print(f"Equivalent RMS: {np.sqrt(reference_power):.10g}")
    return reference_power


def format_tag_value(value):
    if value is None:
        return "none"
    if isinstance(value, float):
        text = f"{value:g}"
    else:
        text = str(value)
    return re.sub(r"[^A-Za-z0-9]+", "p", text).strip("p") or "0"


def make_run_tag(args):
    return (
        f"{args.dataset}_tau{format_tag_value(args.tau)}"
        f"_le{format_tag_value(args.lambda_energy)}"
        f"_k{format_tag_value(args.kappa)}"
        f"_z{args.num_z}_bs{args.batch_size}_seed{args.seed}"
    )


def checkpoint_meta(args, reference_power: float, extra: Dict = None):
    meta = {
        "dataset": args.dataset,
        "tau": args.tau,
        "alpha": args.alpha,
        "lambda_energy": args.lambda_energy,
        "energy_loss_type": args.energy_loss_type,
        "target_snr": args.target_snr,
        "reference_power": reference_power,
        "kappa": args.kappa,
        "num_z": args.num_z,
        "batch_size": args.batch_size,
        "lr": args.lr,
        "seed": args.seed,
        "constraint_scope": args.constraint_scope,
        "train_wshift": args.train_wshift,
        "eval_wshift": args.eval_wshift,
        "uap_dim": args.uap_dim,
        "frame_dim": args.frame_dim,
        "run_tag": args.run_tag,
    }
    if extra:
        meta.update(extra)
    return meta


def energy_gradient_sanity_check(args, device):
    raw_delta = torch.randn(1, args.uap_dim, device=device, requires_grad=True)
    loss = energy_loss_raw_delta(raw_delta, 1.0, args)
    loss.backward()
    if raw_delta.grad is None or torch.count_nonzero(raw_delta.grad).item() == 0:
        raise RuntimeError("Raw-delta energy loss produced an all-zero gradient")


def frame_starts(length: int, wlen: int, wshift: int, max_frames: int = None):
    if length <= wlen:
        return [0]
    starts = list(range(0, length - wlen + 1, wshift))
    if starts[-1] != length - wlen:
        starts.append(length - wlen)
    if max_frames and len(starts) > max_frames:
        idx = np.linspace(0, len(starts) - 1, max_frames).round().astype(int)
        starts = [starts[i] for i in idx]
    return starts


def extract_frames(wav: torch.Tensor, starts: List[int], wlen: int):
    frames = []
    length = wav.numel()
    for start in starts:
        if length <= wlen:
            frame = torch.zeros(wlen, device=wav.device, dtype=wav.dtype)
            frame[:length] = wav
        else:
            frame = wav[start:start + wlen]
        frames.append(frame)
    return torch.stack(frames, dim=0)


@torch.no_grad()
def sentence_test_logits(model, wav_data: torch.Tensor, wlen: int = 3200,
                         wshift: int = 160, batch_size: int = 128):
    """Sentence-level prediction using mean logits, matching the training objective."""
    wav_data = wav_data.squeeze()
    starts = frame_starts(wav_data.numel(), wlen, wshift)
    pred_all = []
    for start in range(0, len(starts), batch_size):
        frames = extract_frames(wav_data, starts[start:start + batch_size], wlen)
        pred_all.append(model(frames))

    logits = torch.cat(pred_all, dim=0)
    return logits.mean(dim=0).argmax()


def repeat_delta_to_utterance(delta: torch.Tensor, length: int):
    repeats = int(np.ceil(length / delta.numel()))
    return delta.repeat(repeats)[:length]


def build_frame_delta(raw_delta: torch.Tensor, args):
    """Project the base UAP for legacy frame-level training."""
    if raw_delta.dim() == 2:
        raw_delta = raw_delta.squeeze(0)
    base_delta = project_l2(raw_delta.view(1, -1), args.tau).squeeze(0)
    return repeat_delta_to_utterance(base_delta, args.frame_dim).view(1, -1)


def build_utterance_delta(raw_delta: torch.Tensor, length: int, args):
    """Build the actual perturbation added to an utterance.

    In the recommended main-experiment setting, tau constrains the fixed
    0.2 s base UAP before repeat/truncate length adaptation.
    """
    if raw_delta.dim() == 2:
        raw_delta = raw_delta.squeeze(0)
    if args.constraint_scope == "base":
        base_delta = project_l2(raw_delta.view(1, -1), args.tau).squeeze(0)
        return repeat_delta_to_utterance(base_delta, length)
    delta_full = repeat_delta_to_utterance(raw_delta, length)
    return project_l2(delta_full.view(1, -1), args.tau).squeeze(0)


def build_utterance_delta_np(raw_delta: np.ndarray, length: int, args):
    raw_delta = np.asarray(raw_delta, dtype=np.float32).reshape(-1)
    if args.constraint_scope == "base":
        norm = max(float(np.linalg.norm(raw_delta, ord=2)), 1e-12)
        base_delta = raw_delta * min(args.tau / norm, 1.0)
        return repeat_to_length(base_delta, length)
    delta_full = repeat_to_length(raw_delta, length)
    norm = max(float(np.linalg.norm(delta_full, ord=2)), 1e-12)
    return delta_full * min(args.tau / norm, 1.0)


def utterance_attack_loss(model, adv_audio: torch.Tensor, label: torch.Tensor,
                          args, use_detector_loss: bool = False):
    max_frames = None if args.train_max_frames <= 0 else args.train_max_frames
    starts = frame_starts(adv_audio.numel(), args.frame_dim, args.train_wshift, max_frames)
    frames = extract_frames(adv_audio, starts, args.frame_dim)
    logits = model(frames)

    if use_detector_loss:
        probs = torch.softmax(logits, dim=1)
        benign_prob = probs[:, BENIGN_LABEL].mean().clamp_min(args.detector_eps)
        loss = torch.exp(args.beta * (-torch.log(benign_prob))) - 1.0
        return loss, logits

    utterance_logits = logits.mean(dim=0, keepdim=True)
    return recognition_attack_loss(utterance_logits, label.view(1), args.kappa), logits


class RunningAverage:
    def __init__(self):
        self.sums = {}
        self.counts = {}

    def update(self, values: Dict[str, float], counts: Dict[str, int]):
        for key, value in values.items():
            self.sums[key] = self.sums.get(key, 0.0) + float(value) * counts[key]
            self.counts[key] = self.counts.get(key, 0) + counts[key]

    def average(self):
        return {key: self.sums[key] / max(self.counts[key], 1) for key in self.sums}


def dataset_paths(dataset: str, data_root: str):
    if dataset == "timit":
        return {
            "data_folder": data_root,
            "train_scp": os.path.join(data_root, "processed", "train_8_2.scp"),
            "test_scp": os.path.join(data_root, "processed", "test_8_2.scp"),
            "label_dict": os.path.join(data_root, "processed", "TIMIT_labels.npy"),
        }
    if dataset == "libri":
        split_dir = os.path.join(data_root, "Librispeech_spkid_sel", "split_spk_list")
        return {
            "data_folder": os.path.join(data_root, "Librispeech_spkid_sel"),
            "train_scp": os.path.join(split_dir, "libri_tr_8_2.scp"),
            "test_scp": os.path.join(split_dir, "libri_te_8_2.scp"),
            "label_dict": os.path.join(split_dir, "libri_dict.npy"),
        }
    raise ValueError(f"Unsupported dataset: {dataset}")


def build_train_dataset(dataset: str, data_root: str, wlen: int, frame_mode: str):
    if dataset == "timit":
        return TIMITDetectorDataset(data_root, train=True, wlen=wlen, frame_mode=frame_mode)
    if dataset == "libri":
        return LibriSpeechDetectorDataset(data_root, train=True, wlen=wlen, frame_mode=frame_mode)
    raise ValueError(f"Unsupported dataset: {dataset}")


class SEUAPUtteranceDataset(Dataset):
    """Full-utterance dataset for utterance-aware SE-UAP training."""

    def __init__(self, file_list: List[str], data_folder: str, label_dict: Dict, fs: int = 16000):
        self.file_list = file_list
        self.data_folder = data_folder
        self.label_dict = label_dict
        self.fs = fs

    def __len__(self):
        return len(self.file_list)

    def __getitem__(self, index):
        fname = self.file_list[index]
        audio, _, norm_factor = load_audio(os.path.join(self.data_folder, fname),
                                           expected_fs=self.fs, normalize=True)
        return torch.from_numpy(audio).float(), int(self.label_dict[fname]), norm_factor


def utterance_collate(batch):
    audios, labels, norm_factors = zip(*batch)
    return list(audios), torch.tensor(labels).long(), torch.tensor(norm_factors).float()


def resolve_detector_path(args):
    if args.detector_model:
        return args.detector_model
    if args.dataset == "timit":
        if not args.libri_pretrained_detector:
            raise ValueError("TIMIT main experiment requires --libri_pretrained_detector")
        return args.libri_pretrained_detector
    if args.dataset == "libri":
        if not args.timit_pretrained_detector:
            raise ValueError("LibriSpeech main experiment requires --timit_pretrained_detector")
        return args.timit_pretrained_detector
    raise ValueError(f"Unsupported dataset: {args.dataset}")


def detector_checkpoint_metadata(detector_path: str):
    state = torch.load(detector_path, map_location="cpu")
    if not isinstance(state, dict):
        return {
            "detector_type": "cnn",
            "training_level": "unknown",
            "detector_train_domain": "unknown",
            "detector_attacks": "unknown",
        }
    return {
        "detector_type": state.get("detector_type", "cnn"),
        "training_level": state.get("training_level", "frame"),
        "detector_train_domain": state.get("train_domain", "unknown"),
        "detector_attacks": ",".join(state.get("attacks", [])),
    }


def train_one_epoch(generator, speaker_model, detector, loader, optimizer, args, device, epoch):
    generator.train()
    speaker_model.eval()
    detector.eval()

    avg = RunningAverage()
    pbar = tqdm(loader, desc=f"SE-UAP train epoch {epoch + 1}/{args.epochs}", unit="batch")
    for clean, speaker_id, _ in pbar:
        clean = clean.float().to(device)
        speaker_id = speaker_id.long().to(device)
        batch_size = clean.size(0)

        loss_r_items = []
        loss_d_items = []
        loss_e_items = []
        fr_items = []
        frd_items = []
        raw_l2_items = []
        base_l2_items = []
        full_l2_items = []
        linf_items = []
        projection_items = []
        deployed_energy_items = []
        snr_items = []

        for _ in range(args.num_z):
            z = torch.randn(1, args.noise_dim, device=device)
            raw_delta = generator(z)
            base_delta = build_frame_delta(raw_delta, args)
            loss_e_items.append(energy_loss_raw_delta(raw_delta, args.reference_power, args))
            delta = base_delta.expand_as(clean)
            adv = torch.clamp(clean + delta, -1.0, 1.0)

            speaker_logits = speaker_model(adv)
            detector_logits = detector(adv)

            loss_r_items.append(recognition_attack_loss(speaker_logits, speaker_id, args.kappa))
            loss_d_items.append(detection_evasion_loss(detector_logits, beta=args.beta, eps=args.detector_eps))

            with torch.no_grad():
                pred_speaker = speaker_logits.argmax(dim=1)
                fr_items.append((pred_speaker != speaker_id).float().mean().item())
                pred_detector = detector_logits.argmax(dim=1)
                frd_items.append((pred_detector == BENIGN_LABEL).float().mean().item())
                diff = adv - clean
                raw_norm = raw_delta.view(1, -1).norm(p=2, dim=1)
                raw_l2_items.append(raw_norm.mean().item())
                base_l2_items.append(base_delta.view(1, -1).norm(p=2, dim=1).mean().item())
                projection_items.append((raw_norm > args.tau).float().mean().item())
                full_l2_items.append(diff.view(batch_size, -1).norm(p=2, dim=1).mean().item())
                linf_items.append(diff.abs().amax(dim=1).mean().item())
                deployed_energy = relative_perturbation_energy(diff, clean, args.energy_eps).item()
                deployed_energy_items.append(deployed_energy)
                snr_items.append(float(-10.0 * np.log10(deployed_energy + args.energy_eps)))

        loss_r = torch.stack(loss_r_items).mean()
        loss_d = torch.stack(loss_d_items).mean()
        loss_e = torch.stack(loss_e_items).mean()
        loss = loss_r + args.alpha * loss_d + args.lambda_energy * loss_e

        optimizer.zero_grad(set_to_none=True)
        loss.backward()
        optimizer.step()

        values = {
            "loss": loss.item(),
            "loss_r": loss_r.item(),
            "loss_d": loss_d.item(),
            "loss_energy": loss_e.item(),
            "train_fr": float(np.mean(fr_items)),
            "train_frd": float(np.mean(frd_items)),
            "raw_delta_l2": float(np.mean(raw_l2_items)),
            "base_delta_l2": float(np.mean(base_l2_items)),
            "full_delta_l2": float(np.mean(full_l2_items)),
            "delta_linf": float(np.mean(linf_items)),
            "projection_rate": float(np.mean(projection_items)),
            "deployed_relative_energy": float(np.mean(deployed_energy_items)),
            "estimated_snr": float(np.mean(snr_items)),
        }
        avg.update(values, {key: batch_size for key in values})
        pbar.set_postfix(loss=f"{loss.item():.4f}",
                         fr=f"{values['train_fr']:.3f}",
                         frd=f"{values['train_frd']:.3f}")

    return avg.average()


def train_one_epoch_utterance(generator, speaker_model, detector, loader, optimizer, args, device, epoch):
    generator.train()
    speaker_model.eval()
    detector.eval()

    avg = RunningAverage()
    pbar = tqdm(loader, desc=f"SE-UAP utterance train epoch {epoch + 1}/{args.epochs}", unit="batch")
    for clean_list, speaker_ids, _ in pbar:
        speaker_ids = speaker_ids.long().to(device)
        batch_size = len(clean_list)

        loss_r_items = []
        loss_d_items = []
        loss_e_items = []
        fr_items = []
        frd_items = []
        raw_l2_items = []
        base_l2_items = []
        full_l2_items = []
        linf_items = []
        projection_items = []
        deployed_energy_items = []
        snr_items = []

        for _ in range(args.num_z):
            z = torch.randn(1, args.noise_dim, device=device)
            raw_delta = generator(z).squeeze(0)
            loss_e_items.append(energy_loss_raw_delta(raw_delta, args.reference_power, args))
            base_delta = project_l2(raw_delta.view(1, -1), args.tau).squeeze(0)

            with torch.no_grad():
                raw_norm = raw_delta.norm(p=2)
                raw_l2_items.append(raw_norm.item())
                base_l2_items.append(base_delta.norm(p=2).item())
                projection_items.append(float((raw_norm > args.tau).item()))

            for clean_cpu, speaker_id in zip(clean_list, speaker_ids):
                clean = clean_cpu.to(device)
                if args.constraint_scope == "base":
                    delta_full = repeat_delta_to_utterance(base_delta, clean.numel())
                else:
                    delta_full = build_utterance_delta(raw_delta, clean.numel(), args)
                adv = torch.clamp(clean + delta_full, -1.0, 1.0)

                loss_r_i, speaker_logits = utterance_attack_loss(
                    speaker_model, adv, speaker_id, args, use_detector_loss=False
                )
                loss_d_i, detector_logits = utterance_attack_loss(
                    detector, adv, speaker_id, args, use_detector_loss=True
                )
                loss_r_items.append(loss_r_i)
                loss_d_items.append(loss_d_i)

                with torch.no_grad():
                    speaker_utt_logits = speaker_logits.mean(dim=0)
                    detector_utt_logits = detector_logits.mean(dim=0)
                    fr_items.append(float((speaker_utt_logits.argmax() != speaker_id).item()))
                    frd_items.append(float(detector_utt_logits.argmax().item() == BENIGN_LABEL))
                    actual_delta = adv - clean
                    full_l2_items.append(actual_delta.norm(p=2).item())
                    linf_items.append(actual_delta.abs().max().item())
                    deployed_energy = relative_perturbation_energy(
                        actual_delta.view(1, -1), clean.view(1, -1), args.energy_eps
                    ).item()
                    deployed_energy_items.append(deployed_energy)
                    snr_items.append(float(-10.0 * np.log10(deployed_energy + args.energy_eps)))

        loss_r = torch.stack(loss_r_items).mean()
        loss_d = torch.stack(loss_d_items).mean()
        loss_e = torch.stack(loss_e_items).mean()
        loss = loss_r + args.alpha * loss_d + args.lambda_energy * loss_e

        optimizer.zero_grad(set_to_none=True)
        loss.backward()
        optimizer.step()

        values = {
            "loss": loss.item(),
            "loss_r": loss_r.item(),
            "loss_d": loss_d.item(),
            "loss_energy": loss_e.item(),
            "train_fr": float(np.mean(fr_items)),
            "train_frd": float(np.mean(frd_items)),
            "raw_delta_l2": float(np.mean(raw_l2_items)),
            "base_delta_l2": float(np.mean(base_l2_items)),
            "full_delta_l2": float(np.mean(full_l2_items)),
            "delta_linf": float(np.mean(linf_items)),
            "projection_rate": float(np.mean(projection_items)),
            "deployed_relative_energy": float(np.mean(deployed_energy_items)),
            "estimated_snr": float(np.mean(snr_items)),
        }
        avg.update(values, {key: batch_size * args.num_z for key in values})
        pbar.set_postfix(loss=f"{loss.item():.4f}",
                         fr=f"{values['train_fr']:.3f}",
                         frd=f"{values['train_frd']:.3f}")

    return avg.average()


def precompute_uap_pool(generator, args, device):
    generator.eval()
    pool = []
    torch_gen = torch.Generator(device=device).manual_seed(args.seed)
    with torch.no_grad():
        for _ in range(args.pool_size):
            z = torch.randn(1, args.noise_dim, device=device, generator=torch_gen)
            raw_delta = generator(z)
            pool.append(raw_delta.squeeze(0).detach().cpu().numpy())
    return pool


def choose_uap_delta(uap_pool: List[np.ndarray], length: int, args,
                     file_index: int = 0, rng: random.Random = None):
    if args.eval_pool_mode == "deterministic":
        raw_delta = uap_pool[file_index % len(uap_pool)]
    else:
        if rng is None:
            rng = random.Random(args.seed)
        raw_delta = rng.choice(uap_pool)
    return build_utterance_delta_np(raw_delta, length, args)


def split_train_validation(file_list: List[str], val_fraction: float, seed: int) -> Tuple[List[str], List[str]]:
    if val_fraction <= 0.0:
        return file_list, []
    indices = list(range(len(file_list)))
    rng = random.Random(seed)
    rng.shuffle(indices)
    val_size = max(1, int(round(len(indices) * val_fraction)))
    val_indices = set(indices[:val_size])
    train_files = [fname for idx, fname in enumerate(file_list) if idx not in val_indices]
    val_files = [fname for idx, fname in enumerate(file_list) if idx in val_indices]
    return train_files, val_files


def validate(generator, speaker_model, detector, file_list: List[str], data_folder: str,
             label_dict: Dict, args, device, epoch: int):
    generator.eval()
    speaker_model.eval()
    detector.eval()

    eval_files = file_list
    if args.val_max_files > 0:
        eval_files = file_list[:args.val_max_files]

    uap_pool = precompute_uap_pool(generator, args, device)
    metrics = RunningAverage()
    pbar = tqdm(eval_files, desc=f"SE-UAP val epoch {epoch + 1}", unit="file", leave=False)
    for file_index, fname in enumerate(pbar):
        audio, _, _ = load_audio(os.path.join(data_folder, fname), expected_fs=16000, normalize=True)
        label = label_dict[fname]
        delta_full = choose_uap_delta(uap_pool, len(audio), args, file_index=file_index)
        adv = np.clip(audio + delta_full, -1.0, 1.0)
        snr = SNR(adv, audio)

        adv_tensor = torch.from_numpy(adv).float().to(device)
        with torch.no_grad():
            pred_speaker = sentence_test_logits(speaker_model, adv_tensor, wlen=args.frame_dim,
                                                wshift=args.eval_wshift,
                                                batch_size=args.eval_batch_size)
            pred_detector = sentence_test_logits(detector, adv_tensor, wlen=args.frame_dim,
                                                 wshift=args.eval_wshift,
                                                 batch_size=args.eval_batch_size)
        if torch.is_tensor(pred_speaker):
            pred_speaker = pred_speaker.item()
        if torch.is_tensor(pred_detector):
            pred_detector = pred_detector.item()

        values = {
            "val_fr": float(pred_speaker != label),
            "val_frd": float(pred_detector == BENIGN_LABEL),
            "val_snr": snr,
        }
        metrics.update(values, {key: 1 for key in values})
        pbar.set_postfix(fr=f"{values['val_fr']:.0f}",
                         frd=f"{values['val_frd']:.0f}",
                         snr=f"{snr:.2f}")

    if not eval_files:
        return {}
    out = metrics.average()
    out["val_score"] = out["val_fr"] + args.val_frd_weight * out["val_frd"]
    if out["val_frd"] < args.best_min_frd:
        out["val_score"] = -1e9 + out["val_fr"]
    out["val_quality_eligible"] = float(
        out["val_frd"] >= args.best_min_frd
        and (args.best_min_snr is None or out["val_snr"] >= args.best_min_snr)
    )
    return out


def evaluate(generator, speaker_model, detector, file_list: List[str], data_folder: str,
             label_dict: Dict, args, device):
    generator.eval()
    speaker_model.eval()
    detector.eval()
    uap_pool = precompute_uap_pool(generator, args, device)
    rng = random.Random(args.seed)
    metrics = RunningAverage()

    pbar = tqdm(file_list, desc=f"SE-UAP eval {args.dataset}", unit="file")
    for file_index, fname in enumerate(pbar):
        audio, fs, _ = load_audio(os.path.join(data_folder, fname), expected_fs=16000, normalize=True)
        label = label_dict[fname]

        tic = time.perf_counter()
        delta_full = choose_uap_delta(uap_pool, len(audio), args, file_index=file_index, rng=rng)
        adv = np.clip(audio + delta_full, -1.0, 1.0)
        atc = time.perf_counter() - tic

        snr = SNR(adv, audio)
        try:
            pesq = PESQ(audio, adv, fs)
        except Exception as exc:
            print(f"Warning: PESQ failed for {fname}: {exc}")
            pesq = float("nan")

        adv_tensor = torch.from_numpy(adv).float().to(device)
        with torch.no_grad():
            pred_speaker = sentence_test_logits(speaker_model, adv_tensor, wlen=args.frame_dim,
                                                wshift=args.eval_wshift,
                                                batch_size=args.eval_batch_size)
            pred_detector = sentence_test_logits(detector, adv_tensor, wlen=args.frame_dim,
                                                 wshift=args.eval_wshift,
                                                 batch_size=args.eval_batch_size)

        if torch.is_tensor(pred_speaker):
            pred_speaker = pred_speaker.item()
        if torch.is_tensor(pred_detector):
            pred_detector = pred_detector.item()

        fr = float(pred_speaker != label)
        frd = float(pred_detector == BENIGN_LABEL)
        values = {
            "FR": fr,
            "FRD": frd,
            "SNR": snr,
            "PESQ": pesq,
            "ATC": atc,
        }
        metrics.update(values, {key: 1 for key in values})
        pbar.set_postfix(fr=f"{fr:.0f}", frd=f"{frd:.0f}", snr=f"{snr:.2f}", pesq=f"{pesq:.2f}")

    out = metrics.average()
    out["SEI"] = out.get("FRD", 0.0) / max(out.get("ATC", 0.0), 1e-12)
    return out


def write_eval_results(metrics: Dict, args, detector_meta: Dict):
    os.makedirs(args.output_dir, exist_ok=True)
    csv_path = os.path.join(args.output_dir, f"se_uap_eval_{args.dataset}_{time.strftime('%Y%m%d_%H%M%S')}.csv")
    columns = [
        "run_tag",
        "dataset",
        "detector_model",
        "detector_type",
        "detector_training_level",
        "detector_train_domain",
        "detector_attacks",
        "FR",
        "FRD",
        "SNR",
        "PESQ",
        "ATC",
        "SEI",
        "tau",
        "kappa",
        "alpha",
        "gamma",
        "lambda_energy",
        "energy_loss_type",
        "target_snr",
        "reference_power",
        "constraint_scope",
        "num_z",
        "batch_size",
        "lr",
        "seed",
        "uap_dim",
        "train_wshift",
        "eval_wshift",
        "eval_pool_mode",
        "train_max_frames",
    ]
    row = {
        "run_tag": args.run_tag,
        "dataset": args.dataset,
        "detector_model": resolve_detector_path(args),
        "detector_type": detector_meta["detector_type"],
        "detector_training_level": detector_meta["training_level"],
        "detector_train_domain": detector_meta["detector_train_domain"],
        "detector_attacks": detector_meta["detector_attacks"],
        "tau": args.tau,
        "kappa": args.kappa,
        "alpha": args.alpha,
        "gamma": args.gamma,
        "lambda_energy": args.lambda_energy,
        "energy_loss_type": args.energy_loss_type,
        "target_snr": args.target_snr,
        "reference_power": args.reference_power,
        "constraint_scope": args.constraint_scope,
        "num_z": args.num_z,
        "batch_size": args.batch_size,
        "lr": args.lr,
        "seed": args.seed,
        "uap_dim": args.uap_dim,
        "train_wshift": args.train_wshift,
        "eval_wshift": args.eval_wshift,
        "eval_pool_mode": args.eval_pool_mode,
        "train_max_frames": args.train_max_frames,
        **metrics,
    }
    with open(csv_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=columns)
        writer.writeheader()
        writer.writerow({key: row.get(key, "") for key in columns})
    print(f"Saved evaluation CSV: {csv_path}")


def parse_args():
    parser = argparse.ArgumentParser("SE-UAP main experiment")
    parser.add_argument("--mode", choices=["train", "test"], default="train")
    parser.add_argument("--dataset", choices=["timit", "libri"], required=True)
    parser.add_argument("--data_root", type=str, required=True)
    parser.add_argument("--speaker_model", type=str, required=True)
    parser.add_argument("--speaker_cfg", type=str, required=True)

    parser.add_argument("--detector_model", type=str, default=None,
                        help="Optional explicit detector path. Overrides cross-dataset detector selection.")
    parser.add_argument("--libri_pretrained_detector", type=str, default=None,
                        help="Detector pre-trained on LibriSpeech, used when --dataset timit.")
    parser.add_argument("--timit_pretrained_detector", type=str, default=None,
                        help="Detector pre-trained on TIMIT, used when --dataset libri.")

    parser.add_argument("--output_dir", type=str, default="./output/se_uap_main")
    parser.add_argument("--test_ckpt", type=str, default=None)
    parser.add_argument("--init_ckpt", type=str, default=None,
                        help="Initialize generator weights for train mode without restoring optimizer state")
    parser.add_argument("--noise_dim", type=int, default=100)
    parser.add_argument("--frame_dim", type=int, default=3200)
    parser.add_argument("--uap_dim", type=int, default=3200)
    parser.add_argument("--wlen", type=int, default=200, help="training frame length in milliseconds")
    parser.add_argument("--frame_mode", choices=["fixed", "random"], default="random")
    parser.add_argument("--train_objective", choices=["utterance", "frame"], default="utterance",
                        help="utterance matches sentence-level evaluation; frame keeps the legacy frame loss")
    parser.add_argument("--train_wshift", type=int, default=3200,
                        help="sliding-window shift in samples for utterance-aware training")
    parser.add_argument("--train_max_frames", type=int, default=0,
                        help="maximum frames sampled per utterance; 0 uses all frames to match evaluation")
    parser.add_argument("--pool_size", type=int, default=5)

    parser.add_argument("--tau", type=float, default=0.1, help="L2 perturbation bound")
    parser.add_argument("--constraint_scope", choices=["base", "full_utterance"], default="base",
                        help="base constrains the fixed 0.2 s UAP before repeat/truncate adaptation")
    parser.add_argument("--kappa", type=float, default=0.0,
                        help="positive logit-margin confidence for the recognition attack loss")
    parser.add_argument("--num_z", type=int, default=1,
                        help="number of latent UAP samples averaged per batch")
    parser.add_argument("--alpha", type=float, default=1.0, help="detector evasion loss weight")
    parser.add_argument("--lambda_energy", type=float, default=0.0,
                        help="raw-delta energy regularization weight")
    parser.add_argument("--gamma", type=float, default=None,
                        help="deprecated alias for --lambda_energy")
    parser.add_argument("--energy_loss_type", choices=["raw_relative", "target_snr"], default="raw_relative")
    parser.add_argument("--target_snr", type=float, default=10.0)
    parser.add_argument("--beta", type=float, default=1.0, help="detector evasion loss sharpness")
    parser.add_argument("--detector_eps", type=float, default=1e-8)
    parser.add_argument("--energy_eps", type=float, default=1e-12,
                        help="numerical floor for clean-signal energy in relative energy loss")
    parser.add_argument("--val_fraction", type=float, default=0.1,
                        help="fraction of training utterances reserved for validation; 0 disables validation")
    parser.add_argument("--val_max_files", type=int, default=0,
                        help="maximum validation utterances per epoch; 0 uses the full validation split")
    parser.add_argument("--val_frd_weight", type=float, default=0.25,
                        help="best-checkpoint score is val_fr + val_frd_weight * val_frd")
    parser.add_argument("--best_min_frd", type=float, default=0.0,
                        help="minimum validation FRD required when selecting the best checkpoint")
    parser.add_argument("--best_min_snr", type=float, default=None,
                        help="optional minimum validation SNR required when selecting the best checkpoint")

    parser.add_argument("--epochs", type=int, default=50)
    parser.add_argument("--batch_size", type=int, default=128)
    parser.add_argument("--eval_batch_size", type=int, default=128)
    parser.add_argument("--lr", type=float, default=0.001)
    parser.add_argument("--num_workers", type=int, default=0)
    parser.add_argument("--eval_wshift", type=int, default=3200,
                        help="sliding-window shift in samples for sentence-level evaluation")
    parser.add_argument("--eval_pool_mode", choices=["deterministic", "random"], default="deterministic")
    parser.add_argument("--seed", type=int, default=1234)
    parser.add_argument("--device", type=str, default="cuda" if torch.cuda.is_available() else "cpu")
    args = parser.parse_args()
    lambda_energy_was_set = any(
        item == "--lambda_energy" or item.startswith("--lambda_energy=")
        for item in sys.argv[1:]
    )
    if args.gamma is not None and not lambda_energy_was_set:
        args.lambda_energy = args.gamma
    if args.gamma is None:
        args.gamma = args.lambda_energy
    args.run_tag = make_run_tag(args)
    return args


def main():
    args = parse_args()
    seed_all(args.seed)
    device = torch.device(args.device)
    os.makedirs(args.output_dir, exist_ok=True)

    detector_path = resolve_detector_path(args)
    detector_meta = detector_checkpoint_metadata(detector_path)
    print(f"Dataset: {args.dataset}")
    print(f"Using cross-dataset detector: {detector_path}")
    print(
        "Detector checkpoint: "
        f"type={detector_meta['detector_type']}, "
        f"training_level={detector_meta['training_level']}, "
        f"train_domain={detector_meta['detector_train_domain']}, "
        f"attacks={detector_meta['detector_attacks']}"
    )

    speaker_model = load_speaker_model(args.speaker_model, args.speaker_cfg, device)
    detector = load_detector_model(detector_path, device)
    for model in [speaker_model, detector]:
        model.eval()
        for p in model.parameters():
            p.requires_grad = False

    paths = dataset_paths(args.dataset, args.data_root)
    file_list = read_list(paths["test_scp"])
    label_dict = np.load(paths["label_dict"], allow_pickle=True).item()

    generator = Generator1D(args.noise_dim, args.uap_dim).to(device)
    energy_gradient_sanity_check(args, device)

    train_reference_files = read_list(paths["train_scp"])
    args.reference_power = load_or_estimate_reference_speech_power(
        args, train_reference_files, paths["data_folder"]
    )

    if args.mode == "train":
        val_files = []
        if args.init_ckpt:
            load_checkpoint(generator, args.init_ckpt, map_location=device)
            print(f"Initialized generator from: {args.init_ckpt}")
        if args.train_objective == "utterance":
            train_file_list, val_files = split_train_validation(train_reference_files, args.val_fraction, args.seed)
            print(
                f"Train utterances: {len(train_file_list)}, "
                f"validation utterances: {len(val_files)}"
            )
            train_dataset = SEUAPUtteranceDataset(train_file_list, paths["data_folder"], label_dict)
            collate_fn = utterance_collate
        else:
            train_dataset = build_train_dataset(args.dataset, args.data_root, args.wlen, args.frame_mode)
            collate_fn = None
        loader = DataLoader(
            train_dataset,
            batch_size=args.batch_size,
            shuffle=True,
            num_workers=args.num_workers,
            pin_memory=torch.cuda.is_available(),
            worker_init_fn=partial(init_worker, seed=args.seed),
            collate_fn=collate_fn,
        )

        optimizer = torch.optim.Adam(generator.parameters(), lr=args.lr, betas=(0.95, 0.999))
        writer = SummaryWriter(os.path.join(args.output_dir, f"run_{time.strftime('%Y%m%d_%H%M%S')}"))
        best_score = -float("inf")
        best_unconstrained_score = -float("inf")
        best_ckpt_path = os.path.join(args.output_dir, f"se_uap_{args.run_tag}_best.pth")
        best_unconstrained_ckpt_path = os.path.join(
            args.output_dir, f"se_uap_{args.run_tag}_best_unconstrained.pth"
        )
        for epoch in range(args.epochs):
            if args.train_objective == "utterance":
                train_metrics = train_one_epoch_utterance(
                    generator, speaker_model, detector, loader, optimizer, args, device, epoch
                )
            else:
                train_metrics = train_one_epoch(generator, speaker_model, detector, loader, optimizer, args, device, epoch)
            print(f"Epoch {epoch + 1}: {train_metrics}")
            for key, value in train_metrics.items():
                writer.add_scalar(f"train/{key}", value, epoch)

            if args.train_objective == "utterance" and val_files:
                val_metrics = validate(
                    generator, speaker_model, detector, val_files,
                    paths["data_folder"], label_dict, args, device, epoch
                )
                print(f"Validation epoch {epoch + 1}: {val_metrics}")
                for key, value in val_metrics.items():
                    writer.add_scalar(f"val/{key}", value, epoch)
                val_score = val_metrics.get("val_score", -float("inf"))
                if val_score > best_unconstrained_score:
                    best_unconstrained_score = val_score
                    save_checkpoint(
                        generator,
                        best_unconstrained_ckpt_path,
                        optimizer=optimizer,
                        meta=checkpoint_meta(args, args.reference_power, {
                            "epoch": epoch + 1,
                            "val_metrics": val_metrics,
                            "train_max_frames": args.train_max_frames,
                            "selection": "best_unconstrained",
                        }),
                    )
                    print(f"Saved best unconstrained generator: {best_unconstrained_ckpt_path}")

                if args.best_min_snr is None:
                    candidate_score = val_score
                    is_better = candidate_score > best_score
                else:
                    candidate_score = val_metrics.get("val_fr", -float("inf"))
                    is_better = bool(val_metrics.get("val_quality_eligible", 0.0)) and candidate_score > best_score
                if is_better:
                    best_score = candidate_score
                    save_checkpoint(
                        generator,
                        best_ckpt_path,
                        optimizer=optimizer,
                        meta=checkpoint_meta(args, args.reference_power, {
                            "epoch": epoch + 1,
                            "val_metrics": val_metrics,
                            "train_max_frames": args.train_max_frames,
                            "selection": "best",
                        }),
                    )
                    print(f"Saved best generator: {best_ckpt_path}")

        ckpt_path = os.path.join(args.output_dir, f"se_uap_{args.run_tag}_final.pth")
        save_checkpoint(
            generator,
            ckpt_path,
            optimizer=optimizer,
            meta=checkpoint_meta(args, args.reference_power, {
                "epoch": args.epochs,
                "train_max_frames": args.train_max_frames,
                "selection": "final",
            }),
        )
        print(f"Saved generator: {ckpt_path}")
        if val_files and os.path.isfile(best_ckpt_path):
            print(f"Best generator by validation score: {best_ckpt_path} (score={best_score:.4f})")
            print(f"Loading best generator for final test evaluation: {best_ckpt_path}")
            load_checkpoint(generator, best_ckpt_path, map_location=device)
        elif val_files and os.path.isfile(best_unconstrained_ckpt_path):
            print("No checkpoint satisfied the configured quality constraints.")
            print(f"Loading best unconstrained generator for final test evaluation: {best_unconstrained_ckpt_path}")
            load_checkpoint(generator, best_unconstrained_ckpt_path, map_location=device)
        writer.close()
    else:
        if not args.test_ckpt:
            raise ValueError("--test_ckpt is required in test mode")
        load_checkpoint(generator, args.test_ckpt, map_location=device)

    eval_metrics = evaluate(generator, speaker_model, detector, file_list, paths["data_folder"], label_dict, args, device)
    print(
        f"SE-UAP {args.dataset}: FR={eval_metrics['FR']:.4f}, FRD={eval_metrics['FRD']:.4f}, "
        f"SNR={eval_metrics['SNR']:.2f}, PESQ={eval_metrics['PESQ']:.4f}, "
        f"ATC={eval_metrics['ATC'] * 1000:.4f} ms, SEI={eval_metrics['SEI']:.4f}"
    )
    write_eval_results(eval_metrics, args, detector_meta)


if __name__ == "__main__":
    main()
